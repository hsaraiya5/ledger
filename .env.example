# Ledger's settings. `node scripts/setup.mjs init` copies this to .env.local and fills in the generated ones;
# docs/SETUP.md says where every other value comes from. Never commit .env.local.

# The one email that can sign in.
ALLOWED_EMAIL=

# Supabase (node scripts/setup.mjs supabase-keys <ref> fills these in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Used only from this machine to push the schema; not sent to Vercel.
SUPABASE_DB_PASSWORD=

# Plaid (dashboard.plaid.com > Developers > Keys). Start with sandbox; switch to production once approved.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=sandbox
# For banks that sign in through their own site (OAuth), in production: https://<your site>/plaid/oauth
PLAID_REDIRECT_URI=

# Generated: encrypts Plaid logins at rest, and guards the daily sync.
PLAID_TOKEN_KEY=
CRON_SECRET=

# Your deployed address, e.g. https://ledger-yourname.vercel.app
NEXT_PUBLIC_SITE_URL=

# Run with made-up data and no accounts: npm run demo
# NEXT_PUBLIC_DEMO_MODE=1
